# ─────────────────────────────────────────────────────────────────
# Bankflow — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_USER=bankflow
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Redis ─────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT ───────────────────────────────────────────────────────────
# Minimum 64 characters, base64-encoded random bytes recommended:
#   openssl rand -base64 64
JWT_SECRET=CHANGE_ME_AT_LEAST_64_CHAR_BASE64_SECRET
JWT_ACCESS_TOKEN_EXPIRY_MS=900000      # 15 minutes
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ── Internal service-to-service shared secret ─────────────────────
# Used to protect /internal/** endpoints from external callers.
#   openssl rand -hex 32
INTERNAL_SERVICE_SECRET=CHANGE_ME_INTERNAL_SECRET

# ── Grafana ───────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ── AI / LLM ──────────────────────────────────────────────────────
# For local Ollama (no key needed):
SPRING_AI_OLLAMA_BASE_URL=http://localhost:11434
# For OpenAI (set if using hosted API instead of Ollama):
# SPRING_AI_OPENAI_API_KEY=sk-...

# ── Mail (MailHog for local dev, real SMTP for prod) ─────────────
MAIL_HOST=localhost
MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=
